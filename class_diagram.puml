' 5. DECORATOR PATTERN (Extended Features)
' ============================================
package "Decorator Pattern (Extended Features)" {
    abstract class KU00298794_BookDecorator <<Decorator>> {
        #decoratedBook: KU00298794_Book
        +KU00298794_BookDecorator(book: KU00298794_Book)
        +getDecoratedBook(): KU00298794_Book
        +{abstract} getDescription(): String
        +{abstract} getAdditionalInfo(): String
