        +KU00298794_SpecialEditionDecorator(book: KU00298794_Book, editionType: String, specialFeatures: String)
        +getDescription(): String
        +getAdditionalInfo(): String
        +getEditionInfo(): String
    }
}

' ============================================
' 6. OBSERVER PATTERN (Notifications)
' ============================================
package "Observer Pattern (Notifications)" {
    interface KU00298794_Observer <<Observer>> {
        +update(message: String): void
        +getObserverId(): String
    }

    class KU00298794_NotificationService <<Subject>> {
        -observers: List<KU00298794_Observer>
        +KU00298794_NotificationService()
        +attach(observer: KU00298794_Observer): void
        +detach(observer: KU00298794_Observer): void
        +notifyObservers(message: String): void
        +notifyDueDateReminder(user: KU00298794_User, book: KU00298794_Book): void
        +notifyOverdue(user: KU00298794_User, book: KU00298794_Book, fine: double): void
        +notifyReservationAvailable(user: KU00298794_User, book: KU00298794_Book): void
        -notifyObserversByUser(user: KU00298794_User, message: String): void
    }

    class KU00298794_EmailNotification <<ConcreteObserver>> {
        -email: String
        -userId: String
        +KU00298794_EmailNotification(userId: String, email: String)
        +update(message: String): void
        +getObserverId(): String
        -sendEmail(message: String): void
    }

    class KU00298794_SMSNotification <<ConcreteObserver>> {
        -phoneNumber: String
        -userId: String
        +KU00298794_SMSNotification(userId: String, phoneNumber: String)
        +update(message: String): void
        +getObserverId(): String
        -sendSMS(message: String): void
    }
}

