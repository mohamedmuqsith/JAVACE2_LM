        +execute(): boolean
        +undo(): boolean
        +getDescription(): String
    }

    class KU00298794_ReturnCommand <<ConcreteCommand>> {
        -user: KU00298794_User
        -book: KU00298794_Book
        -service: KU00298794_BorrowingService
        -executed: boolean
        +KU00298794_ReturnCommand(user: KU00298794_User, book: KU00298794_Book, service: KU00298794_BorrowingService)
        +execute(): boolean
        +undo(): boolean
        +getDescription(): String
    }

    class KU00298794_ReserveCommand <<ConcreteCommand>> {
        -user: KU00298794_User
        -book: KU00298794_Book
        -service: KU00298794_ReservationService
        -executed: boolean
        +KU00298794_ReserveCommand(user: KU00298794_User, book: KU00298794_Book, service: KU00298794_ReservationService)
        +execute(): boolean
        +undo(): boolean
        +getDescription(): String
    }

    class KU00298794_CancelReservationCommand <<ConcreteCommand>> {
        -user: KU00298794_User
        -book: KU00298794_Book
        -service: KU00298794_ReservationService
        -executed: boolean
        +KU00298794_CancelReservationCommand(user: KU00298794_User, book: KU00298794_Book, service: KU00298794_ReservationService)
        +execute(): boolean
        +undo(): boolean
        +getDescription(): String
    }

    class KU00298794_CommandInvoker <<Invoker>> {
        -commandHistory: List<KU00298794_Command>
        +KU00298794_CommandInvoker()
        +executeCommand(command: KU00298794_Command): boolean
        +undoLastCommand(): boolean
        +getHistory(): List<KU00298794_Command>
        +printHistory(): void
