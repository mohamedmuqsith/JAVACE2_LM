' ============================================
' 1. BUILDER PATTERN (Creation)
' ============================================
package "Builder Pattern (Book Creation)" {
    class KU00298794_BookBuilder <<Builder>> {
        -bookId: String
        -title: String
        -author: String
        -category: String
        -isbn: String
        -reviews: List<KU00298794_Review>
        -tags: List<String>
