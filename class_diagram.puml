' ============================================
' 3. STATE PATTERN (Book Availability)
' ============================================
package "State Pattern (Book Availability)" {
    interface KU00298794_BookState <<State>> {
        +borrow(book: KU00298794_Book, user: KU00298794_User): boolean
        +returnBook(book: KU00298794_Book): boolean
        +reserve(book: KU00298794_Book, user: KU00298794_User): boolean
        +getStateName(): String
    }

    class KU00298794_AvailableState <<ConcreteState>> {
        +borrow(book: KU00298794_Book, user: KU00298794_User): boolean
        +returnBook(book: KU00298794_Book): boolean
        +reserve(book: KU00298794_Book, user: KU00298794_User): boolean
        +getStateName(): String
    }

    class KU00298794_BorrowedState <<ConcreteState>> {
        +borrow(book: KU00298794_Book, user: KU00298794_User): boolean
        +returnBook(book: KU00298794_Book): boolean
        +reserve(book: KU00298794_Book, user: KU00298794_User): boolean
        +getStateName(): String
    }

    class KU00298794_ReservedState <<ConcreteState>> {
        +borrow(book: KU00298794_Book, user: KU00298794_User): boolean
        +returnBook(book: KU00298794_Book): boolean
        +reserve(book: KU00298794_Book, user: KU00298794_User): boolean
        +getStateName(): String
    }
}

' ============================================
' 4. STRATEGY PATTERN (Fine Calculation)
' ============================================
package "Strategy Pattern (Fine Calculation)" {
    interface KU00298794_FineCalculationStrategy <<Strategy>> {
        +calculateFine(daysOverdue: int): double
        +getFineRate(): double
    }

    class KU00298794_StudentFineStrategy <<ConcreteStrategy>> {
        -FINE_RATE: double {static}
        +calculateFine(daysOverdue: int): double
        +getFineRate(): double
    }

    class KU00298794_FacultyFineStrategy <<ConcreteStrategy>> {
        -FINE_RATE: double {static}
        +calculateFine(daysOverdue: int): double
        +getFineRate(): double
    }

    class KU00298794_GuestFineStrategy <<ConcreteStrategy>> {
        -FINE_RATE: double {static}
        +calculateFine(daysOverdue: int): double
        +getFineRate(): double
    }
}

