        -manageBooks(): void
        -manageUsers(): void
        -borrowBook(): void
        -returnBook(): void
        -reserveBook(): void
        -viewReports(): void
        -demonstrateDesignPatterns(): void
        -undoLastAction(): void
        -initializeSampleData(): void
        +{static} main(args: String[]): void
