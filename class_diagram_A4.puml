' ========== BUILDER PATTERN ==========
package "Builder Pattern" #LightYellow {
    class KU00298794_BookBuilder <<Builder>> {
        -bookId: String
        -title: String
        -author: String
        -category: String
        -isbn: String
        -reviews: List<Review>
        -tags: List<String>
        -edition: String
        --
        +KU00298794_BookBuilder()
        +setBookId(bookId: String): KU00298794_BookBuilder
        +setTitle(title: String): KU00298794_BookBuilder
        +setAuthor(author: String): KU00298794_BookBuilder
        +setCategory(category: String): KU00298794_BookBuilder
        +setIsbn(isbn: String): KU00298794_BookBuilder
        +addReview(reviewer: String, rating: double, comment: String): KU00298794_BookBuilder
        +addTag(tag: String): KU00298794_BookBuilder
        +setEdition(edition: String): KU00298794_BookBuilder
        +build(): KU00298794_Book
    }
}

' ========== CORE MODEL ==========
package "Core Model" #LightBlue {
    abstract class KU00298794_User {
        -userId: String
        -name: String
        -email: String
        -contactNumber: String
        -membershipType: String
        -borrowedBooks: List<BorrowRecord>
        -transactionHistory: List<Transaction>
        -fineStrategy: FineCalculationStrategy
        --
        +{abstract} getBorrowingLimit(): int
        +{abstract} getDueDays(): int
        +getId(): String
        +getName(): String
        +getEmail(): String
        +getContactNumber(): String
        +getMembershipType(): String
        +getBorrowedBooks(): List<BorrowRecord>
        +addBorrowRecord(record: BorrowRecord): void
        +removeBorrowRecord(record: BorrowRecord): void
        +calculateFine(daysOverdue: int): double
        +payFine(amount: double): void
        +getTransactionHistory(): List<Transaction>
        +getFineStrategy(): FineCalculationStrategy
        +toString(): String
    }

    class KU00298794_Student {
        -BORROWING_LIMIT: int {static}
        -DUE_DAYS: int {static}
        --
        +KU00298794_Student(userId, name, email, contactNumber)
        +getBorrowingLimit(): int
        +getDueDays(): int
    }

    class KU00298794_Faculty {
        -BORROWING_LIMIT: int {static}
        -DUE_DAYS: int {static}
        --
        +KU00298794_Faculty(userId, name, email, contactNumber)
        +getBorrowingLimit(): int
        +getDueDays(): int
    }

    class KU00298794_Guest {
        -BORROWING_LIMIT: int {static}
        -DUE_DAYS: int {static}
        --
        +KU00298794_Guest(userId, name, email, contactNumber)
        +getBorrowingLimit(): int
        +getDueDays(): int
    }

    class KU00298794_Book {
        -bookId: String
        -title: String
        -author: String
        -category: String
        -isbn: String
        -currentState: BookState
        -borrowedHistory: List<BorrowRecord>
        -reservationQueue: Queue<Reservation>
        -reviews: List<Review>
        -tags: List<String>
        -edition: String
        --
        +getBookId(): String
        +getTitle(): String
        +getAuthor(): String
        +getCategory(): String
        +getIsbn(): String
        +getState(): BookState
        +setState(state: BookState): void
        +getBorrowedHistory(): List<BorrowRecord>
        +addBorrowRecord(record: BorrowRecord): void
        +getReservationQueue(): Queue<Reservation>
        +addReservation(user: User): void
        +getNextReserver(): User
        +borrow(user: User): boolean
        +returnBook(): boolean
        +reserve(user: User): boolean
        +getDescription(): String
        +setReviews(reviews: List<Review>): void
        +setTags(tags: List<String>): void
        +setEdition(edition: String): void
        +getReviews(): List<Review>
        +getTags(): List<String>
        +getEdition(): String
        +toString(): String
    }

    class KU00298794_Librarian {
        -librarianId: String
        -name: String
        -email: String
        --
        +getLibrarianId(): String
        +getName(): String
        +getEmail(): String
        +verifyMember(userId: String): boolean
        +collectFine(user: User, amount: double): void
        +toString(): String
    }

    class KU00298794_BorrowRecord {
        -user: User
        -book: Book
        -borrowDate: Date
        -dueDate: Date
        -returnDate: Date
        -fineAmount: double
        --
        +getUser(): User
        +getBook(): Book
        +getBorrowDate(): Date
        +getDueDate(): Date
        +getReturnDate(): Date
        +setReturnDate(returnDate: Date): void
        +getFineAmount(): double
        +setFineAmount(fineAmount: double): void
        +isOverdue(): boolean
        +calculateOverdueDays(): int
        +toString(): String
    }

    class KU00298794_Reservation {
        -reservationId: String
        -user: User
        -book: Book
        -reservationDate: Date
        -status: String
        --
        +fulfill(): void
        +cancel(): void
        +getReservationId(): String
        +getUser(): User
        +getBook(): Book
        +getReservationDate(): Date
        +getStatus(): String
    }

    class KU00298794_Transaction {
        -transactionId: String
        -user: User
        -amount: double
        -date: Date
        -type: String
        --
        +process(): void
        +getTransactionId(): String
        +getAmount(): double
        +getType(): String
        +getDate(): Date
    }

    class KU00298794_Review {
        -reviewerName: String
        -rating: double
        -comment: String
        -date: Date
        --
        +toString(): String
        +getReviewerName(): String
        +getRating(): double
        +getComment(): String
    }
}

' ========== STATE PATTERN ==========
package "State Pattern" #LightGreen {
    interface KU00298794_BookState <<State>> {
        +borrow(book: Book, user: User): boolean
        +returnBook(book: Book): boolean
        +reserve(book: Book, user: User): boolean
        +getStateName(): String
    }

    class KU00298794_AvailableState <<ConcreteState>> {
        +borrow(book, user): boolean
        +returnBook(book): boolean
        +reserve(book, user): boolean
        +getStateName(): String
    }

    class KU00298794_BorrowedState <<ConcreteState>> {
        +borrow(book, user): boolean
        +returnBook(book): boolean
        +reserve(book, user): boolean
        +getStateName(): String
    }

    class KU00298794_ReservedState <<ConcreteState>> {
        +borrow(book, user): boolean
        +returnBook(book): boolean
        +reserve(book, user): boolean
        +getStateName(): String
    }
}

' ========== STRATEGY PATTERN ==========
package "Strategy Pattern" #LightPink {
    interface KU00298794_FineCalculationStrategy <<Strategy>> {
        +calculateFine(daysOverdue: int): double
        +getFineRate(): double
    }

    class KU00298794_StudentFineStrategy <<ConcreteStrategy>> {
        -FINE_RATE: double {static}
        --
        +calculateFine(daysOverdue: int): double
        +getFineRate(): double
    }

    class KU00298794_FacultyFineStrategy <<ConcreteStrategy>> {
        -FINE_RATE: double {static}
        --
        +calculateFine(daysOverdue: int): double
        +getFineRate(): double
    }

    class KU00298794_GuestFineStrategy <<ConcreteStrategy>> {
        -FINE_RATE: double {static}
        --
        +calculateFine(daysOverdue: int): double
        +getFineRate(): double
    }
}

' ========== DECORATOR PATTERN ==========
package "Decorator Pattern" #Wheat {
    abstract class KU00298794_BookDecorator <<Decorator>> {
        #decoratedBook: Book
        --
        +KU00298794_BookDecorator(book: Book)
        +getDecoratedBook(): Book
        +{abstract} getDescription(): String
        +{abstract} getAdditionalInfo(): String
    }

    class KU00298794_FeaturedBookDecorator <<ConcreteDecorator>> {
        -featuredReason: String
        --
        +getDescription(): String
        +getAdditionalInfo(): String
        +getFeaturedReason(): String
    }

    class KU00298794_RecommendedBookDecorator <<ConcreteDecorator>> {
        -recommendedBy: String
        -rating: double
        --
        +getDescription(): String
        +getAdditionalInfo(): String
        +getRecommendation(): String
    }

    class KU00298794_SpecialEditionDecorator <<ConcreteDecorator>> {
        -editionType: String
        -specialFeatures: String
        --
        +getDescription(): String
        +getAdditionalInfo(): String
        +getEditionInfo(): String
    }
}

' ========== OBSERVER PATTERN ==========
package "Observer Pattern" #LightCyan {
    interface KU00298794_Observer <<Observer>> {
        +update(message: String): void
        +getObserverId(): String
    }

    class KU00298794_NotificationService <<Subject>> {
        -observers: List<Observer>
        --
        +attach(observer: Observer): void
        +detach(observer: Observer): void
        +notifyObservers(message: String): void
        +notifyDueDateReminder(user, book): void
        +notifyOverdue(user, book, fine): void
        +notifyReservationAvailable(user, book): void
        -notifyObserversByUser(user, message): void
    }

    class KU00298794_EmailNotification <<ConcreteObserver>> {
        -email: String
        -userId: String
        --
        +update(message: String): void
        +getObserverId(): String
        -sendEmail(message: String): void
    }

    class KU00298794_SMSNotification <<ConcreteObserver>> {
        -phoneNumber: String
        -userId: String
        --
        +update(message: String): void
        +getObserverId(): String
        -sendSMS(message: String): void
    }
}

' ========== COMMAND PATTERN ==========
package "Command Pattern" #Lavender {
    interface KU00298794_Command <<Command>> {
        +execute(): boolean
        +undo(): boolean
        +getDescription(): String
    }

    class KU00298794_BorrowCommand <<ConcreteCommand>> {
        -user: User
        -book: Book
        -service: BorrowingService
        -executed: boolean
        --
        +execute(): boolean
        +undo(): boolean
        +getDescription(): String
    }

    class KU00298794_ReturnCommand <<ConcreteCommand>> {
        -user: User
        -book: Book
        -service: BorrowingService
        -executed: boolean
        --
        +execute(): boolean
        +undo(): boolean
        +getDescription(): String
    }

    class KU00298794_ReserveCommand <<ConcreteCommand>> {
        -user: User
        -book: Book
        -service: ReservationService
        -executed: boolean
        --
        +execute(): boolean
        +undo(): boolean
        +getDescription(): String
    }

    class KU00298794_CancelReservationCommand <<ConcreteCommand>> {
        -user: User
        -book: Book
        -service: ReservationService
        -executed: boolean
        --
        +execute(): boolean
        +undo(): boolean
        +getDescription(): String
    }

    class KU00298794_CommandInvoker <<Invoker>> {
        -commandHistory: List<Command>
        --
        +executeCommand(command: Command): boolean
        +undoLastCommand(): boolean
        +getHistory(): List<Command>
        +printHistory(): void
    }
}

