    class KU00298794_Logger <<Singleton>> {
        -{static} instance: Logger
        -logs: List<String>
        -dateFormat: SimpleDateFormat
        --
        +{static} getInstance(): Logger
        +info(message: String): void
        +warning(message: String): void
        +error(message: String): void
        +debug(message: String): void
        -log(level: LogLevel, message: String): void
        +logBorrow(userId, bookId): void
        +logReturn(userId, bookId): void
        +logReservation(userId, bookId): void
        +logFine(userId, amount): void
        +getAllLogs(): List<String>
        +getRecentLogs(count: int): List<String>
        +clearLogs(): void
        +getLogCount(): int
        +printAllLogs(): void
    }

    enum LogLevel {
        INFO
        WARNING
        ERROR
        DEBUG
    }
}

